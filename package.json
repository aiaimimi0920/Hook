{
  "name": "hook",
  "version": "0.1.9",
  "description": "Windows-first Tauri desktop capture, sticker editing, and visual workflow workspace.",
  "type": "module",
  "author": "yamiyu",
  "homepage": "https://github.com/aiaimimi0920/Hook#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiaimimi0920/Hook.git"
  },
  "bugs": {
    "url": "https://github.com/aiaimimi0920/Hook/issues"
  },
  "keywords": [
    "tauri",
    "solidjs",
    "windows",
    "screenshot",
    "workflow"
  ],
  "scripts": {
    "dev": "cmd /d /s /c \"pushd %npm_config_local_prefix% && call node_modules\\.bin\\vite.cmd --port 1420 --strictPort\"",
    "build": "cmd /d /s /c \"pushd %npm_config_local_prefix% && call scripts\\build-static.cmd\"",
    "start": "cmd /d /s /c \"pushd %npm_config_local_prefix% && call scripts\\serve-static.cmd --port 1420 --root .output/public\"",
    "serve:static": "cmd /d /s /c \"pushd %npm_config_local_prefix% && call scripts\\serve-static.cmd --port 1420 --root .output/public\"",
    "dev:tauri": "cmd /d /s /c \"pushd %npm_config_local_prefix% && call scripts\\dev-tauri.cmd\"",
    "tauri": "\"%npm_config_local_prefix%\\scripts\\run-tauri.cmd\"",
    "test": "cmd /d /s /c \"pushd %npm_config_local_prefix% && node_modules\\.bin\\vitest.cmd run --pool threads --maxWorkers 1 --no-file-parallelism\"",
    "test:performance": "cmd /d /s /c \"pushd %npm_config_local_prefix% && node_modules\\.bin\\vitest.cmd run __tests__\\performance\\RuntimePerformanceGates.test.ts --pool threads --maxWorkers 1 --no-file-parallelism\"",
    "test:surface-browser": "node scripts/run-javascript-surface-browser-smoke.mjs",
    "generate:surface-bootstrap": "node scripts/generate-javascript-surface-bootstrap.mjs",
    "check:surface-bootstrap": "node scripts/generate-javascript-surface-bootstrap.mjs --check",
    "test:effective-lines": "node --test scripts/tests/effective-code-lines.test.mjs scripts/tests/javascript-surface-bootstrap.test.mjs",
    "test:parallel": "cmd /d /s /c \"pushd %npm_config_local_prefix% && node_modules\\.bin\\vitest.cmd run --pool threads --maxWorkers 4 --fileParallelism\"",
    "test:watch": "cmd /d /s /c \"pushd %npm_config_local_prefix% && node_modules\\.bin\\vitest.cmd watch --pool threads --maxWorkers 1 --no-file-parallelism\"",
    "bench:shader": "node scripts/run-shader-benchmark.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src --max-warnings 0",
    "check:effective-lines": "node scripts/effective-code-lines.mjs --mode ratchet --json artifacts/effective-code-lines.json",
    "check:effective-lines:strict": "node scripts/effective-code-lines.mjs --mode strict --json artifacts/effective-code-lines-strict.json",
    "verify:version": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\assert-release-version.ps1",
    "test:dependency-security": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\tests\\Test-DependencySecurityContract.ps1",
    "test:homepage-fixture": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\tests\\Test-HomepageSessionFixture.ps1",
    "audit:dependencies": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\Invoke-DependencySecurityScan.ps1",
    "audit:licenses": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\audit-open-source-dependencies.ps1",
    "verify:local": "cmd /d /s /c \"pushd %npm_config_local_prefix% && call npm run verify:version && call npm run test:dependency-security && call npm run test:homepage-fixture && call npm run audit:dependencies && call npm run audit:licenses && call npm run test:effective-lines && call npm run check:effective-lines && call npm run lint && call npm run typecheck && call npm run typecheck:test && call npm test && call npm run test:surface-browser && call cargo fmt --check --manifest-path src-tauri\\Cargo.toml && call cargo test --manifest-path src-tauri\\Cargo.toml && call npm run build && call build-hook-release.bat\""
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "solid-js": "^1.9.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/postcss": "^4.3.2",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^22.20.0",
    "autoprefixer": "^10.5.2",
    "eslint": "^10.8.0",
    "eslint-plugin-solid": "^0.15.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.16",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.4.3",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "picomatch": "4.0.5",
    "rollup": "4.62.2"
  }
}
